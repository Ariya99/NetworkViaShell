{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetworkViaShell",
  "version": "0.1.0",
  "identifier": "dev.networkviashell.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"NetworkViaShell","width":1100,"height":760,"minWidth":720,"minHeight":520,"resizable":true}],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {"active":true,"targets":"all"}
}
